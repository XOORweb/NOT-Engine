// Define Components
NOR1
NOR2
BUTTON3(QON)
BUTTON4(QOFF)
BUTTON5(View)
AND6
AND7
LOG8(Currently switch is on QON)
LOG9(Currently switch is on QOFF)

// Define Connections
NOR2(2IN)> NOR1
NOR1(2IN)> NOR2
BUTTON3(1IN)> NOR2
BUTTON4(1IN)> NOR1
NOR2(1IN)> AND7
NOR1(1IN)> AND6
BUTTON5(2IN)> AND6
BUTTON5(2IN)> AND7
AND6(1IN)> LOG8
AND7(1IN)> LOG9